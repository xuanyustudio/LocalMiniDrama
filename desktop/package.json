{
  "name": "localminidrama-desktop",
  "version": "1.2.9",
  "description": "LocalMiniDrama 本地桌面客户端",
  "main": "main.js",
  "author": "LocalMiniDrama",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/copy-backend.js",
    "start": "electron .",
    "build:front": "cd ../frontweb && npm run build",
    "copy-front": "node scripts/copy-front.js",
    "clean:unpacked": "node scripts/clean-win-unpacked.js",
    "pack": "npm run prepare-backend && npm run build:front && npm run copy-front && npm run clean:unpacked && electron-builder --dir",
    "dist": "npm run prepare-backend && npm run build:front && npm run copy-front && npm run clean:unpacked && electron-builder --win",
    "dist:cn": "node scripts/dist-cn.js",
    "dist:mac": "bash dist-mac.sh",
    "postinstall": "node scripts/copy-backend.js && electron-builder install-app-deps",
    "prepare-backend": "node scripts/copy-backend.js"
  },
  "dependencies": {
    "@volcengine/openapi": "^1.36.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "js-yaml": "^4.3.1",
    "jsonrepair": "^3.13.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.localminidrama.desktop",
    "productName": "灵动创世",
    "artifactName": "LocalMiniDrama ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "backend-app/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**"
    ],
    "extraResources": [
      {
        "from": "frontweb-dist",
        "to": "frontweb/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../example_drama",
        "to": "example_drama",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend-node/tools/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@44.2.0": true,
    "electron-winstaller@5.4.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.4": true
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "axios": "1.20.0",
    "form-data": "4.0.6",
    "path-to-regexp": "0.1.13",
    "qs": "6.16.0",
    "uuid": "$uuid",
    "body-parser": "1.20.6"
  }
}
